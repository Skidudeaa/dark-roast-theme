    "status": "unmeasured",
    "rationale": "Companion surfaces are intentionally lighter than Black Label; no device-specific pixel wake-time measurement is inherited."
  },
  "appTargets": {
    "somaCURA": {
      "severityMapping": {
        "_note": "Option C (v4.1.0): worsening/improving/stable moved off the amberHot/amber/gold cluster (3° hue spread — collapsed at scanning distance) onto distinct hue families. Color is category only; directional states MUST render paired iconography + sparkline (see iconography table in docs/DESIGN-SYSTEM.md §6).",
        "critical": "scarlet",
        "worsening": "magenta",
        "improving": "harvest",
        "stable": "olive",
        "resolved": "teal"
      },
      "liveIndicator": "teal",
      "pipeline": [
        "Clinical Update",
        "HyperDrive NER",
        "Problem Approval",
        "SSE Stream → Note"
      ],
