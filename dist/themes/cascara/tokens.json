{
  "themeName": "Dark Roast: Cascara",
  "version": "5.5.0",
  "status": "COMPANION",
  "_cssMapping": "JSON uses camelCase. CSS uses --dr-kebab-case. Examples: espressoHover → --dr-espresso-hover, amberHot → --dr-amber-hot, darkCacao → --dr-dark-cacao, burntSienna → --dr-burnt-sienna, craterDeep → --dr-crater-deep.",
  "_migration": {
    "from": "3.0.0",
    "breaking": [
      "grain → espresso (value #C9B1AF unchanged)",
      "grainHover → espressoHover (value #B99D9A unchanged)",
      "crater → craterDeep (value #906966 unchanged)",
      "craterLight/craterLt → crater (value #865D59 unchanged, now top of surface scale)",
      "New primitives: darkCacao #D2BFBD, roastedBean #9F7C79, burntSienna #9D3401, brass #6C5500",
      "Added semantic role aliases (accent, success, error, warning, critical, stable) pointing at color primitives"
    ]
  },
  "_build": {
    "_note": "Config consumed by scripts/build-tokens.js. Editing this changes generated output.",
    "opacityVariantColors": [
      "amber",
      "amberHot",
      "gold",
      "scarlet",
      "teal",
      "brass",
      "burntSienna",
      "magenta",
      "harvest",
      "olive"
    ],
    "opacityTiers": {
      "dim": 0.4,
      "subtle": 0.1,
      "ghost": 0.05
    },
    "divider": {
      "color": "crema",
      "alpha": 0.04
    }
  },
  "colors": {
    "_surfaceScale": "Monotonic dark→light: void → obsidian → darkCacao → espresso → roastedBean → crater",
    "void": "#E5DBDA",
    "obsidian": "#DCCDCB",
    "darkCacao": "#D2BFBD",
    "espresso": "#C9B1AF",
    "espressoHover": "#B99D9A",
    "roastedBean": "#9F7C79",
    "crater": "#865D59",
    "_foregrounds": "crema = hero/display, bone = reading midpoint, mocha = muted body, warmWhite = bright callouts",
    "crema": "#010000",
    "warmWhite": "#050101",
    "bone": "#130504",
    "mocha": "#441A18",
    "_geologicalAccents": "craterDeep = darker geological accent, asparagus = tertiary metadata, rustic/rose = grounded error states",
    "craterDeep": "#906966",
    "asparagus": "#294205",
    "rustic": "#C25C5F",
    "rose": "#B35E99",
    "_actionColors": "Color-name primitives. Semantic roles below alias these.",
    "amber": "#7D4E00",
    "amberHot": "#973C00",
    "amberMuted": "#864901",
    "gold": "#705300",
    "brass": "#6C5500",
    "scarlet": "#B4001B",
    "burntSienna": "#9D3401",
    "teal": "#006262",
    "_severityHues": "Companion-tuned severity hues remain deliberately distinct; validate exact separation with scripts/validate-themes.js.",
    "magenta": "#740270",
    "harvest": "#755200",
    "olive": "#4B5E00"
  },
  "roles": {
    "_note": "Semantic pointers into colors. Use these in new code for portability; color-name primitives remain canonical.",
