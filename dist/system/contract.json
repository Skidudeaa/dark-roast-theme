{
  "name": "operational-interface-doctrine",
  "version": "0.1.0",
  "naming": {
    "cssClassPrefix": "oi-",
    "cssVariablePrefix": "--oi-",
    "axisAttributePrefix": "data-oi-",
    "slotAttribute": "data-oi-slot",
    "typeScriptTypePrefix": "Oi",
    "swiftTypePrefix": "OI"
  },
  "axes": {
    "surface": [
      "canvas",
      "base",
      "raised",
      "interactive",
      "inset",
      "overlay",
      "scrim"
    ],
    "activity": [
      "idle",
      "loading",
      "refreshing",
      "live",
      "ready",
      "failed"
    ],
    "severity": [
      "neutral",
      "informational",
      "positive",
      "warning",
      "negative",
      "critical"
    ],
    "freshness": [
      "live",
      "recent",
      "stale",
      "unknown"
    ],
    "certainty": [
      "confirmed",
      "inferred",
      "uncertain",
      "disputed"
    ],
    "completeness": [
      "complete",
      "partial",
      "missing",
      "unavailable"
    ],
    "source": [
      "direct",
      "derived",
      "generated",
      "user-entered",
      "external"
    ],
    "emphasis": [
      "quiet",
      "normal",
      "strong"
    ],
    "density": [
      "compact",
      "standard",
      "spacious"
    ]
  },
  "axisStability": {
    "surface": "stable",
    "activity": "stable",
    "severity": "stable",
    "freshness": "stable",
    "certainty": "stable",
    "completeness": "stable",
    "source": "stable",
    "emphasis": "stable",
    "density": "stable"
  },
  "truthAxes": {
    "members": [
      "source",
      "freshness",
      "certainty",
      "completeness"
    ]
  },
  "semanticRoles": {
    "surface": [
      "canvas",
      "base",
      "raised",
      "interactive",
      "hover",
      "inset",
      "overlay",
      "scrim"
    ],
    "text": [
      "primary",
      "body",
      "muted",
      "inverse",
      "link"
    ],
    "border": [
      "subtle",
      "default",
      "strong",
      "focus"
    ],
    "status": [
      "informational",
      "positive",
      "warning",
      "negative",
      "critical",
      "live"
    ],
    "accent": [
      "primary",
      "active",
      "muted"
    ],
    "typography": [
      "body",
      "heading",
      "display",
      "mono"
    ],
    "geometry": [
      "space",
      "radius-control",
      "radius-surface",
      "radius-overlay"
    ],
    "motion": [
      "duration-fast",
      "duration-normal",
      "duration-slow",
      "ease-standard",
      "ease-emphasized"
    ],
    "interaction": [
      "focus-ring-width",
      "focus-ring-offset",
      "pointer-target-min",
      "touch-target-min"
    ]
  },
  "primitives": {
    "surface": {
      "responsibility": "Containment, background, border, elevation, clipping",
      "axes": [
        "surface",
        "emphasis",
        "severity"
      ]
    },
    "stack": {
      "responsibility": "Vertical rhythm; parent owns gap and alignment",
      "axes": [
        "density"
      ]
    },
    "cluster": {
      "responsibility": "Inline grouping with gap, alignment, and wrap policy",
      "axes": [
        "density"
      ]
    },
    "rail": {
      "responsibility": "Fixed and fluid column relationship with an explicit collapse rule",
      "axes": [
        "density"
      ]
    },
    "inset": {
      "responsibility": "Recessed focus, evidence, or visualization region with an overflow policy",
      "axes": [
        "surface"
      ]
    },
    "divider": {
      "responsibility": "Structural separation, declared semantic or decorative",
      "axes": [
        "emphasis"
      ]
    },
    "metric": {
      "responsibility": "Label, value, unit, trend, and provenance alignment with tabular numerics",
      "axes": [
        "severity",
        "emphasis",
        "source",
        "freshness",
        "certainty",
        "completeness"
      ]
    },
    "meter": {
      "responsibility": "Normalized quantitative progress with accessible min, max, current, and label",
      "axes": [
        "severity",
        "activity"
      ]
    },
    "disclosure": {
      "responsibility": "Expandable content structure owning aria-expanded and focus behavior",
      "axes": [
        "density"
      ]
    },
    "history-strip": {
      "responsibility": "Compact temporal distribution with a non-color intensity channel",
      "axes": [
        "severity",
        "freshness"
      ]
    }
  },
  "recipes": {
    "compact-monitor": {
      "stability": "experimental",
      "study": "docs/OPERATIONAL-INTERFACE-DOCTRINE.md",
      "slotOrder": [
        "context",
        "actions",
        "focus",
        "status",
        "primary",
        "details",
        "history",
        "settings"
      ],
      "requiredSlots": [
        "status",
        "primary"
      ],
      "optionalSlots": [
        "context",
        "actions",
        "focus",
        "details",
        "history",
        "settings"
      ],
      "supportedDensities": [
        "compact",
        "standard"
      ],
      "publicHooks": []
    }
  },
  "reservedRecipeNames": {
    "names": [
      "dense-inspector",
      "operational-summary",
      "contextual-sidebar",
      "conversation-shell",
      "context-composer"
    ]
  },
  "stabilityLadder": {
    "stages": [
      "study",
      "candidate",
      "experimental",
      "proven",
      "stable",
      "deprecated"
    ]
  },
  "forbiddenDomainTerms": {
    "terms": [
      "patient",
      "physician",
      "clinician",
      "diagnosis",
      "medication",
      "potassium",
      "vitals",
      "census",
      "discharge",
      "admission",
      "encounter",
      "triage",
      "acuity",
      "portfolio",
      "drawdown",
      "ticker",
      "inbox",
      "mailbox"
    ]
  },
  "generatedTypes": {
    "surface": "OiSurface",
    "activity": "OiActivity",
    "severity": "OiSeverity",
    "freshness": "OiFreshness",
    "certainty": "OiCertainty",
    "completeness": "OiCompleteness",
    "source": "OiSource",
    "emphasis": "OiEmphasis",
    "density": "OiDensity",
    "primitive": "OiPrimitive",
    "recipe": "OiRecipe",
    "slot": "OiSlot"
  }
}
