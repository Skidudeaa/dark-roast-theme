  // ==========================================================================
  // SEMANTIC TOKEN COLORS
  // These run AFTER textmate scopes and override them when VS Code's language
  // server has type-resolved information. Prefer semantic tokens for accuracy.
  // ==========================================================================
  "semanticTokenColors": {
    // ── Variables ──────────────────────────────────────────────────────────
    // crema: default text — variables are the most common token, should be "invisible".
    "variable": "#FFF8F0",
    "variable.readonly": { "foreground": "#FFF8F0", "italic": true },
    // Parameters get italic to signal "input to this scope".
    "parameter": { "foreground": "#FFF8F0", "italic": true },
    "parameter.declaration": { "foreground": "#FFF8F0", "italic": true },

    // ── Properties ─────────────────────────────────────────────────────────
    // bone: slightly receded — object.property reads as "secondary access".
    "property": "#E9DCCF",
    "property.readonly": { "foreground": "#E9DCCF", "italic": true },
    "property.declaration": "#E9DCCF",

    // ── Functions ──────────────────────────────────────────────────────────
    // slate: functions are verbs — cool blue contrasts with warm gold types.
    "function": "#2CB9AA",
    "function.declaration": "#2CB9AA",
    "function.defaultLibrary": {"foreground":"#6AACE2","italic":true},
    "method": "#2CB9AA",
    "method.declaration": "#2CB9AA",
    "method.defaultLibrary": {"foreground":"#6AACE2","italic":true},
    "member": "#2CB9AA",

    // ── Types / Classes ────────────────────────────────────────────────────
    // gold: warm, authoritative structural nouns. Italic for class names (convention).
    "class": { "foreground": "#D0A200" },
    "class.declaration": { "foreground": "#D0A200" },
    "type": "#D0A200",
    "type.declaration": "#D0A200",
    "interface": "#D0A200",
    "struct": "#D0A200",
    "typeParameter": { "foreground": "#D0A200", "italic": true },

    // ── Enums ─────────────────────────────────────────────────────────────
    // enum container = gold (type-level), enum members = amber-hot (constant values).
    "enum": "#D0A200",
    "enumMember": "#FF853D",
    "enumMember.readonly": { "foreground": "#FF853D", "italic": true },

    // ── Namespaces / modules ───────────────────────────────────────────────
    "namespace": "#E9DCCF",
    "module": "#E9DCCF",

    // ── Decorators ─────────────────────────────────────────────────────────
    // amber: meta-programming deserves attention — the primary accent.
    "decorator": "#E9922E",
    "annotation": "#E9922E",

    // ── Keywords ───────────────────────────────────────────────────────────
    // mauve: structural but gentle. You see keywords 500x/day.
    "keyword": "#D28DE2",
    "modifier": "#D28DE2",
    "label": "#D28DE2",

    // ── Operators ─────────────────────────────────────────────────────────
    // teal: connective tissue — eye-catching for = && || without being heavy.
    "operator": "#2CB9AA",
    "operatorOverloaded": { "foreground": "#2CB9AA", "italic": true },

    // ── String literals ────────────────────────────────────────────────────
    "string": "#79B56C",

    // ── Numbers & constants ────────────────────────────────────────────────
    "number": "#FF853D",
    "boolean": { "foreground": "#FF853D", "italic": true },

    // ── Comments ───────────────────────────────────────────────────────────
    // mocha italic: must recede completely. Clearly secondary to code.
    "comment": { "foreground": "#BBA188", "italic": true },
    "comment.documentation": { "foreground": "#BBA188", "italic": true },

    // ── Language-specific overrides ────────────────────────────────────────
    // self/this/super: mauve italic — language-special variables get keyword treatment.
    "selfParameter": { "foreground": "#D28DE2", "italic": true },
    "clsParameter": { "foreground": "#D28DE2", "italic": true },
    "variable.defaultLibrary": {"foreground":"#6AACE2","italic":true},

    // Macros (Rust): amber — like decorators, meta-level constructs.
    "macro": "#E9922E",
    "builtinType": { "foreground": "#D0A200", "italic": true },

    // Lifetime parameters (Rust): mocha — structural but tertiary.
    "lifetime": "#BBA188",
    "format_specifier": "#2CB9AA",

    // Unreachable/invalid code: scarlet — errors should be scarlet.
    "unreachableCode": {"foreground":"#BCA18A","strikethrough":true},
    "deprecated": {"foreground":"#FF853D","strikethrough":true}
  },

  // ==========================================================================
  // TOKEN COLORS (TextMate grammar scopes)
  // Applied in order — later rules override earlier ones for the same scope.
  // Canonical syntax mapping defined in the theme spec; see WHY column above.
  // ==========================================================================
  "tokenColors": [

    // ── Comments ────────────────────────────────────────────────────────────
    // mocha italic: must recede. AA-large (4.4:1 on void) — readable but secondary.
    {
      "name": "Comment — line and block",
      "scope": [
