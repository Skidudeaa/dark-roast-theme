{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Skidudeaa/dark-roast-theme/src/system/contract.schema.json",
  "title": "Operational Interface Doctrine contract manifest",
  "description": "Validates src/system/contract.json (doctrine §14). Structural validation only — cross-reference integrity (recipe slots resolving against slotOrder, primitive axes resolving against declared axes) is enforced by scripts/validate-contract.js, because JSON Schema cannot express it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "naming",
    "axes",
    "axisStability",
    "truthAxes",
    "semanticRoles",
    "primitives",
    "recipes",
    "reservedRecipeNames",
    "stabilityLadder",
    "forbiddenDomainTerms",
    "generatedTypes"
  ],
  "definitions": {
    "note": {
      "type": "string",
      "description": "Human-readable annotation. Keys prefixed with _ are documentation and are stripped from generated output."
    },
    "kebabList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
    },
    "stability": {
      "type": "string",
      "enum": ["study", "candidate", "experimental", "proven", "stable", "deprecated"]
    },
    "kebabArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
    },
    "elementList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9-]*)$" }
    },
    "attributeRules": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "attributeList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "accessibleName": {
      "type": "string",
      "enum": ["none", "contents", "required"]
    },
    "rootContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements", "requiredAttributes", "forbiddenAttributes", "accessibleName"],
      "properties": {
        "elements": { "$ref": "#/definitions/elementList" },
        "requiredAttributes": { "$ref": "#/definitions/attributeRules" },
        "forbiddenAttributes": { "$ref": "#/definitions/attributeList" },
        "accessibleName": { "$ref": "#/definitions/accessibleName" }
      }
    },
    "partContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "elements", "cardinality", "requiredAttributes", "forbiddenAttributes", "accessibleName"],
      "properties": {
        "parent": { "type": "string", "pattern": "^(root|[a-z][a-z0-9]*(-[a-z0-9]+)*)$" },
        "elements": { "$ref": "#/definitions/elementList" },
        "cardinality": {
          "type": "string",
          "enum": ["one", "zero-or-one", "one-or-more", "zero-or-more"]
        },
        "requiredAttributes": { "$ref": "#/definitions/attributeRules" },
        "forbiddenAttributes": { "$ref": "#/definitions/attributeList" },
        "accessibleName": { "$ref": "#/definitions/accessibleName" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_doctrine": { "$ref": "#/definitions/note" },
    "_note": { "$ref": "#/definitions/note" },

    "name": { "type": "string", "const": "operational-interface-doctrine" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Independent semantic version for the doctrine contract (§19), distinct from the package version."
    },

    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cssClassPrefix",
        "cssVariablePrefix",
        "axisAttributePrefix",
        "slotAttribute",
        "typeScriptTypePrefix",
        "swiftTypePrefix"
      ],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "cssClassPrefix": { "type": "string", "const": "oi-" },
        "cssVariablePrefix": { "type": "string", "const": "--oi-" },
        "axisAttributePrefix": { "type": "string", "const": "data-oi-" },
        "slotAttribute": { "type": "string", "const": "data-oi-slot" },
        "typeScriptTypePrefix": { "type": "string", "const": "Oi" },
        "swiftTypePrefix": { "type": "string", "const": "OI" }
      }
    },

    "axes": {
      "type": "object",
      "additionalProperties": false,
      "description": "The nine canonical axes (§7). Closed set: adding an axis is a doctrine change, not a manifest edit. `interaction` is deliberately absent (§7.10).",
      "required": [
        "surface",
        "activity",
        "severity",
        "freshness",
        "certainty",
        "completeness",
        "source",
        "emphasis",
        "density"
      ],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "surface": { "$ref": "#/definitions/kebabList" },
        "activity": { "$ref": "#/definitions/kebabList" },
        "severity": { "$ref": "#/definitions/kebabList" },
        "freshness": { "$ref": "#/definitions/kebabList" },
        "certainty": { "$ref": "#/definitions/kebabList" },
        "completeness": { "$ref": "#/definitions/kebabList" },
        "source": { "$ref": "#/definitions/kebabList" },
        "emphasis": { "$ref": "#/definitions/kebabList" },
        "density": { "$ref": "#/definitions/kebabList" }
      }
    },

    "axisStability": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["stable", "experimental"]
      },
      "properties": { "_note": { "$ref": "#/definitions/note" } }
    },

    "truthAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "members": { "$ref": "#/definitions/kebabList" }
      }
    },

    "semanticRoles": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required semantic contract categories (§8).",
      "required": [
        "surface",
        "text",
        "border",
        "status",
        "accent",
        "typography",
        "geometry",
        "elevation",
        "motion",
        "interaction"
      ],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "surface": { "$ref": "#/definitions/kebabList" },
        "text": { "$ref": "#/definitions/kebabList" },
        "border": { "$ref": "#/definitions/kebabList" },
        "status": { "$ref": "#/definitions/kebabList" },
        "accent": { "$ref": "#/definitions/kebabList" },
        "typography": { "$ref": "#/definitions/kebabList" },
        "geometry": { "$ref": "#/definitions/kebabList" },
        "elevation": { "$ref": "#/definitions/kebabList" },
        "motion": { "$ref": "#/definitions/kebabList" },
        "interaction": { "$ref": "#/definitions/kebabList" }
      }
    },

    "primitives": {
      "type": "object",
      "description": "Exactly ten in the first implementation (§10).",
      "minProperties": 11,
      "maxProperties": 11,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stability",
          "responsibility",
          "axes",
          "root",
          "partOrder",
          "partOrderPolicy",
          "parts",
          "publicHooks"
        ],
        "properties": {
          "stability": { "$ref": "#/definitions/stability" },
          "responsibility": { "type": "string", "minLength": 12 },
          "axes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "root": { "$ref": "#/definitions/rootContract" },
          "partOrder": { "$ref": "#/definitions/kebabArray" },
          "partOrderPolicy": {
            "type": "string",
            "enum": ["none", "listed", "either"]
          },
          "parts": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
            "additionalProperties": { "$ref": "#/definitions/partContract" }
          },
          "publicHooks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^--oi-[a-z][a-z0-9-]*$" }
          }
        }
      },
      "properties": { "_note": { "$ref": "#/definitions/note" } }
    },

    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stability",
          "slotOrder",
          "requiredSlots",
          "optionalSlots",
          "supportedDensities"
        ],
        "properties": {
          "stability": { "$ref": "#/definitions/stability" },
          "study": { "type": "string" },
          "_studyNote": { "$ref": "#/definitions/note" },
          "slotOrder": { "$ref": "#/definitions/kebabList" },
          "requiredSlots": { "$ref": "#/definitions/kebabList" },
          "optionalSlots": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "supportedDensities": { "$ref": "#/definitions/kebabList" },
          "publicHooks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^--oi-" }
          }
        }
      },
      "properties": { "_note": { "$ref": "#/definitions/note" } }
    },

    "reservedRecipeNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names"],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "names": { "$ref": "#/definitions/kebabList" }
      }
    },

    "stabilityLadder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages"],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/definitions/stability" },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },

    "forbiddenDomainTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms"],
      "properties": {
        "_note": { "$ref": "#/definitions/note" },
        "terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }
        }
      }
    },

    "generatedTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^Oi[A-Z][A-Za-z]*$"
      },
      "properties": { "_note": { "$ref": "#/definitions/note" } }
    }
  }
}
