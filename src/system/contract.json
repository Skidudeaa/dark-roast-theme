{
  "$schema": "./contract.schema.json",
  "name": "operational-interface-doctrine",
  "version": "0.4.0",
  "_doctrine": "docs/OPERATIONAL-INTERFACE-DOCTRINE.md",
  "_note": "Machine-readable source of truth for the doctrine's public contract (§14). Hand-edited. scripts/build-system.js generates dist/system/* from this file; scripts/validate-contract.js enforces the schema and cross-references. Changing a stable axis value is a MAJOR version bump (§19) because domain adapters may switch exhaustively.",

  "naming": {
    "_note": "Public naming contract (§6). The namespace is intentionally 'oi', never 'dr' — the doctrine is theme-neutral and Dark Roast is only its first reference mapping.",
    "cssClassPrefix": "oi-",
    "cssVariablePrefix": "--oi-",
    "axisAttributePrefix": "data-oi-",
    "slotAttribute": "data-oi-slot",
    "typeScriptTypePrefix": "Oi",
    "swiftTypePrefix": "OI"
  },

  "axes": {
    "_note": "Orthogonal state axes (§7). The generic `data-state` attribute is prohibited (§5.3): loading is not severity, staleness is not warning, selection is not emphasis, certainty is not freshness, partial data is not a loading state. Interaction is deliberately absent — native pseudo-classes, native attributes, and ARIA own it (§7.10).",
    "surface": ["canvas", "base", "raised", "interactive", "inset", "overlay", "scrim"],
    "activity": ["idle", "loading", "refreshing", "live", "ready", "failed"],
    "severity": ["neutral", "informational", "positive", "warning", "negative", "critical"],
    "freshness": ["live", "recent", "stale", "unknown"],
    "certainty": ["confirmed", "inferred", "uncertain", "disputed"],
    "completeness": ["complete", "partial", "missing", "unavailable"],
    "source": ["direct", "derived", "generated", "user-entered", "external"],
    "emphasis": ["quiet", "normal", "strong"],
    "density": ["compact", "standard", "spacious"]
  },

  "axisStability": {
    "_note": "Stable axes carry semantic-version protection. Adding a value to a stable closed axis is MAJOR (§19).",
    "surface": "stable",
    "activity": "stable",
    "severity": "stable",
    "freshness": "stable",
    "certainty": "stable",
    "completeness": "stable",
    "source": "stable",
    "emphasis": "stable",
    "density": "stable"
  },

  "truthAxes": {
    "_note": "The subset that carries provenance semantics (§9). A truth-bearing primitive MUST provide a non-color channel for every truth property it renders; tooltips alone are insufficient for critical truth state.",
    "members": ["source", "freshness", "certainty", "completeness"]
  },

  "semanticRoles": {
    "_note": "Required semantic contract categories (§8). Primitives and recipes consume ONLY these. Direct use of a palette primitive such as --dr-espresso above the mapping layer is the 'token soup' anti-pattern (§23) and fails validation.",
    "surface": ["canvas", "base", "raised", "interactive", "hover", "inset", "overlay", "scrim"],
    "text": ["primary", "body", "muted", "inverse", "link"],
    "border": ["subtle", "default", "strong", "focus"],
    "status": ["informational", "positive", "warning", "negative", "critical", "live"],
    "accent": ["primary", "active", "muted"],
    "typography": ["body", "heading", "display", "mono", "size-label", "size-body", "size-title", "size-display", "line-compact", "line-reading"],
    "geometry": ["space", "radius-control", "radius-surface", "radius-overlay"],
    "elevation": ["flat", "raised", "overlay", "live", "critical"],
    "motion": ["duration-fast", "duration-normal", "duration-slow", "ease-standard", "ease-emphasized"],
    "interaction": ["focus-ring-width", "focus-ring-offset", "pointer-target-min", "touch-target-min"]
  },

  "primitives": {
    "_note": "The ten initial structural primitives (§10). Every primitive is experimental until real adoption. Root and part contracts make public DOM anatomy executable; owner-qualified part classes are generated as .oi-<primitive>__<part>.",
    "surface": {
      "stability": "experimental",
      "responsibility": "Containment, background, border, elevation, clipping",
      "axes": ["surface", "emphasis", "severity"],
      "root": {
        "elements": ["*"],
        "requiredAttributes": { "data-oi-surface": ["*"] },
        "forbiddenAttributes": [],
        "accessibleName": "none"
      },
      "partOrder": [],
      "partOrderPolicy": "none",
      "parts": {},
      "publicHooks": ["--oi-surface-padding", "--oi-surface-overflow"]
    },
    "stack": {
      "stability": "experimental",
      "responsibility": "Vertical rhythm; parent owns gap and alignment",
      "axes": ["density"],
      "root": {
        "elements": ["*"],
        "requiredAttributes": {},
        "forbiddenAttributes": [],
        "accessibleName": "none"
      },
      "partOrder": [],
      "partOrderPolicy": "none",
      "parts": {},
      "publicHooks": ["--oi-stack-gap", "--oi-stack-align"]
    },
    "cluster": {
      "stability": "experimental",
      "responsibility": "Inline grouping with gap, alignment, and wrap policy",
      "axes": ["density"],
      "root": {
        "elements": ["*"],
        "requiredAttributes": {},
        "forbiddenAttributes": [],
        "accessibleName": "none"
      },
      "partOrder": [],
      "partOrderPolicy": "none",
      "parts": {},
      "publicHooks": ["--oi-cluster-gap", "--oi-cluster-align", "--oi-cluster-justify", "--oi-cluster-wrap"]
    },
    "rail": {
      "stability": "experimental",
      "responsibility": "Fixed and fluid column relationship with an explicit collapse rule",
      "axes": ["density"],
      "root": {
        "elements": ["*"],
        "requiredAttributes": {},
        "forbiddenAttributes": [],
        "accessibleName": "none"
      },
      "partOrder": ["rail", "content"],
      "partOrderPolicy": "either",
      "parts": {
        "rail": {
          "parent": "root",
          "elements": ["*"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "none"
        },
        "content": {
          "parent": "root",
          "elements": ["*"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "none"
        }
      },
      "publicHooks": ["--oi-rail-gap", "--oi-rail-size", "--oi-rail-content-min"]
    },
    "inset": {
      "stability": "experimental",
      "responsibility": "Recessed focus, evidence, or visualization region with an overflow policy",
      "axes": ["surface"],
      "root": {
        "elements": ["*"],
        "requiredAttributes": { "data-oi-surface": ["inset"] },
        "forbiddenAttributes": [],
        "accessibleName": "none"
      },
      "partOrder": [],
      "partOrderPolicy": "none",
      "parts": {},
      "publicHooks": ["--oi-inset-padding", "--oi-inset-overflow"]
    },
    "divider": {
      "stability": "experimental",
      "responsibility": "Structural separation, declared semantic or decorative",
      "axes": ["emphasis"],
      "root": {
        "elements": ["hr"],
        "requiredAttributes": {},
        "forbiddenAttributes": ["tabindex"],
        "accessibleName": "none"
      },
      "partOrder": [],
      "partOrderPolicy": "none",
      "parts": {},
      "publicHooks": ["--oi-divider-size"]
    },
    "metric": {
      "stability": "experimental",
      "responsibility": "Label, value, unit, trend, and provenance alignment with tabular numerics",
      "axes": ["severity", "emphasis", "source", "freshness", "certainty", "completeness"],
      "root": {
        "elements": ["dl"],
        "requiredAttributes": {},
        "forbiddenAttributes": ["role"],
        "accessibleName": "none"
      },
      "partOrder": ["label", "value", "unit", "trend", "provenance"],
      "partOrderPolicy": "listed",
      "parts": {
        "label": {
          "parent": "root",
          "elements": ["dt"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "value": {
          "parent": "root",
          "elements": ["dd"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "unit": {
          "parent": "root",
          "elements": ["dd"],
          "cardinality": "zero-or-one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "trend": {
          "parent": "root",
          "elements": ["dd"],
          "cardinality": "zero-or-one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "provenance": {
          "parent": "root",
          "elements": ["dd"],
          "cardinality": "zero-or-one",
          "requiredAttributes": { "id": ["*"] },
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        }
      },
      "publicHooks": ["--oi-metric-value-size"]
    },
    "meter": {
      "stability": "experimental",
      "responsibility": "Bounded scalar measure with accessible minimum, maximum, current value, and label",
      "axes": ["severity", "activity"],
      "root": {
        "elements": ["div"],
        "requiredAttributes": {},
        "forbiddenAttributes": ["role"],
        "accessibleName": "none"
      },
      "partOrder": ["label", "control", "track", "fill", "value", "description"],
      "partOrderPolicy": "listed",
      "parts": {
        "label": {
          "parent": "root",
          "elements": ["label"],
          "cardinality": "one",
          "requiredAttributes": { "for": ["*"] },
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "control": {
          "parent": "root",
          "elements": ["meter"],
          "cardinality": "one",
          "requiredAttributes": { "id": ["*"], "min": ["*"], "max": ["*"], "value": ["*"] },
          "forbiddenAttributes": ["role", "aria-valuemin", "aria-valuemax", "aria-valuenow"],
          "accessibleName": "required"
        },
        "track": {
          "parent": "root",
          "elements": ["div"],
          "cardinality": "one",
          "requiredAttributes": { "aria-hidden": ["true"] },
          "forbiddenAttributes": [],
          "accessibleName": "none"
        },
        "fill": {
          "parent": "track",
          "elements": ["span"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "none"
        },
        "value": {
          "parent": "root",
          "elements": ["span", "output"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "description": {
          "parent": "root",
          "elements": ["small", "span"],
          "cardinality": "zero-or-one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        }
      },
      "publicHooks": ["--oi-meter-track-size", "--oi-meter-value", "--oi-meter-value-size"]
    },
    "disclosure": {
      "stability": "experimental",
      "responsibility": "Native expandable structure with summary ownership and focus behavior",
      "axes": ["density"],
      "root": {
        "elements": ["details"],
        "requiredAttributes": {},
        "forbiddenAttributes": ["role", "tabindex", "aria-expanded"],
        "accessibleName": "none"
      },
      "partOrder": ["summary", "content"],
      "partOrderPolicy": "listed",
      "parts": {
        "summary": {
          "parent": "root",
          "elements": ["summary"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": ["role", "tabindex", "aria-expanded"],
          "accessibleName": "contents"
        },
        "content": {
          "parent": "root",
          "elements": ["div", "section"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "none"
        }
      },
      "publicHooks": []
    },
    "history-strip": {
      "stability": "experimental",
      "responsibility": "Compact temporal distribution with a non-color intensity channel",
      "axes": ["severity", "freshness"],
      "root": {
        "elements": ["ol"],
        "requiredAttributes": {},
        "forbiddenAttributes": ["role"],
        "accessibleName": "required"
      },
      "partOrder": ["item", "time", "bar", "value"],
      "partOrderPolicy": "listed",
      "parts": {
        "item": {
          "parent": "root",
          "elements": ["li"],
          "cardinality": "one-or-more",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "none"
        },
        "time": {
          "parent": "item",
          "elements": ["time"],
          "cardinality": "one",
          "requiredAttributes": { "datetime": ["*"] },
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        },
        "bar": {
          "parent": "item",
          "elements": ["span"],
          "cardinality": "one",
          "requiredAttributes": { "aria-hidden": ["true"] },
          "forbiddenAttributes": [],
          "accessibleName": "none"
        },
        "value": {
          "parent": "item",
          "elements": ["span"],
          "cardinality": "one",
          "requiredAttributes": {},
          "forbiddenAttributes": [],
          "accessibleName": "contents"
        }
      },
      "publicHooks": ["--oi-history-intensity", "--oi-history-item-size", "--oi-history-gap"]
    }
  },

  "recipes": {
    "_note": "Recipes are the primary unit of reusable design intelligence (§5.15). They define region order, slot anatomy, relationships, density, responsive transformation, surface nesting, optionality, overflow, and disclosure — never business logic, product actions, data fetching, domain language, or palette selection.",
    "compact-monitor": {
      "stability": "experimental",
      "study": "docs/OPERATIONAL-INTERFACE-DOCTRINE.md",
      "_studyNote": "Recorded inline as doctrine §21 (Clauddy). §15 reserves src/system/studies/claude-usage-monitor.md for the extracted standalone study; that file is not yet written, so the reference points at the section that exists rather than a placeholder.",
      "axes": ["surface", "activity", "severity", "freshness", "certainty", "completeness", "source", "density"],
      "root": {
        "elements": ["section"],
        "requiredClasses": ["oi-surface"],
        "requiredAttributes": {
          "data-oi-surface": ["base", "raised"],
          "data-oi-density": ["compact", "standard"]
        },
        "forbiddenAttributes": ["tabindex"],
        "accessibleName": "required"
      },
      "partOrder": ["chrome"],
      "partOrderPolicy": "listed",
      "parts": {
        "chrome": {
          "parent": "root",
          "elements": ["header"],
          "cardinality": "zero-or-one",
          "requiredAttributes": {},
          "forbiddenAttributes": ["tabindex"],
          "accessibleName": "none"
        }
      },
      "slotOrder": ["context", "actions", "focus", "status", "primary", "details", "history", "settings"],
      "requiredSlots": ["status", "primary"],
      "optionalSlots": ["context", "actions", "focus", "details", "history", "settings"],
      "slotParents": {
        "context": "chrome",
        "actions": "chrome",
        "focus": "root",
        "status": "root",
        "primary": "root",
        "details": "root",
        "history": "root",
        "settings": "root"
      },
      "supportedDensities": ["compact", "standard"],
      "widths": {
        "minimumViable": "20rem",
        "preferred": "36rem",
        "wide": "52rem"
      },
      "overflowBehavior": {
        "root": "no-scroll-container",
        "text": "wrap-anywhere",
        "scrollSlots": ["focus", "history"],
        "documentInlineOverflow": "forbidden"
      },
      "truncationBehavior": {
        "default": "none",
        "ellipsisSlots": [],
        "preserveNumericValues": true
      },
      "optionalSlotCollapse": {
        "strategy": "omit",
        "emptySlotElements": "forbidden",
        "residualSpace": "forbidden",
        "conditionalParts": { "chrome": ["context", "actions"] }
      },
      "densityBehavior": {
        "boundary": "required",
        "changes": ["gap", "padding", "control-size"],
        "preserves": ["slot-order", "slot-visibility"]
      },
      "asyncBehavior": {
        "scenarios": ["initial-loading", "ready-complete", "refreshing-retained", "live", "partial", "stale", "missing", "unavailable", "failed", "valid-empty"],
        "ariaBusyActivities": ["loading", "refreshing"],
        "geometryPreservedSlotsOnLoading": ["status", "primary"],
        "retainedSlotsOnRefresh": ["primary"],
        "retainedSlotsWhenStale": ["primary"],
        "failureIsolation": "smallest-responsible-slot",
        "recovery": "visible-action",
        "validEmpty": "ready-not-loading"
      },
      "keyboardFocus": {
        "model": "native",
        "tabOrder": "dom",
        "rootFocusable": false,
        "rovingFocus": false,
        "recipeShortcuts": [],
        "escapeBehavior": "none",
        "responsiveReordering": "forbidden",
        "asyncFocus": "preserve-existing-node"
      },
      "proofFixtures": {
        "mappings": ["dark-roast", "night-shift", "house-blend", "alien"],
        "widths": ["minimum-viable", "preferred", "wide"],
        "densities": ["compact", "standard"],
        "asyncScenarios": ["initial-loading", "ready-complete", "refreshing-retained", "live", "partial", "stale", "missing", "unavailable", "failed", "valid-empty"],
        "states": ["neutral", "live", "warning", "critical", "disabled", "stale", "uncertain", "disputed", "partial", "refreshing", "failed"],
        "stress": ["reduced-motion", "increased-contrast", "forced-colors", "keyboard-focus", "zoom-200-reflow", "ltr", "rtl", "long-labels-2x", "large-negative-numbers", "missing-unknown-unavailable", "no-color"]
      },
      "publicHooks": ["--oi-compact-monitor-gap", "--oi-compact-monitor-primary-gap", "--oi-compact-monitor-loading-min-block-size"]
    }
  },

  "reservedRecipeNames": {
    "_note": "Reserved to prevent competing implementations, but not public contracts until separately designed and proven (§11.2). `conversation-shell` and `context-composer` are candidates arising from src/system/studies/phind-extension.md.",
    "names": [
      "dense-inspector",
      "operational-summary",
      "contextual-sidebar",
      "conversation-shell",
      "context-composer"
    ]
  },

  "stabilityLadder": {
    "_note": "External designs enter through documented studies, never direct transplantation (§18). No stable primitive or recipe exists without a real consumer.",
    "stages": ["study", "candidate", "experimental", "proven", "stable", "deprecated"]
  },

  "forbiddenDomainTerms": {
    "_note": "Domain vocabulary that must not appear in contracts, primitives, or recipes (§5.13, §17.1). Matched case-insensitively on word boundaries by the source scan. Deliberately conservative: generic words such as 'note', 'chart', and 'transfer' are excluded because substring collisions would produce false failures.",
    "terms": [
      "patient",
      "physician",
      "clinician",
      "diagnosis",
      "medication",
      "potassium",
      "vitals",
      "census",
      "discharge",
      "admission",
      "encounter",
      "triage",
      "acuity",
      "portfolio",
      "drawdown",
      "ticker",
      "inbox",
      "mailbox"
    ]
  },

  "generatedTypes": {
    "_note": "TypeScript type names emitted by scripts/build-system.js for each axis, plus the structural enumerations.",
    "surface": "OiSurface",
    "activity": "OiActivity",
    "severity": "OiSeverity",
    "freshness": "OiFreshness",
    "certainty": "OiCertainty",
    "completeness": "OiCompleteness",
    "source": "OiSource",
    "emphasis": "OiEmphasis",
    "density": "OiDensity",
    "primitive": "OiPrimitive",
    "part": "OiPart",
    "recipe": "OiRecipe",
    "slot": "OiSlot"
  }
}
